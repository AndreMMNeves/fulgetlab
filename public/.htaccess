# ============================================================================
#  FulgetLab — configuração do Apache (HostGator / cPanel)
# ----------------------------------------------------------------------------
#  Este arquivo é copiado para dentro de out/ pelo `next build` e deve ficar
#  na RAIZ do public_html, junto com o index.html.
# ============================================================================

# Página de erro do próprio site (em vez da tela padrão da HostGator).
ErrorDocument 404 /404.html

RewriteEngine On

# --- www -> sem www ---------------------------------------------------------
# O site se anuncia como fulgetlab.com.br (ver `url` em src/lib/site.ts).
# Ter os dois endereços ativos divide o SEO, então um redireciona pro outro.
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# --- HTTP -> HTTPS ----------------------------------------------------------
# Ativado em 27/07/2026, com o AutoSSL já emitido no cPanel.
# Sem isso o site responde nos dois endereços (http e https) e o Google trata
# como conteúdo duplicado, dividindo a força entre as duas versões.
#
# Se algum dia o certificado vencer/for removido, comente estas duas linhas —
# senão o navegador passa a mostrar aviso de segurança e o site fica inacessível.
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --- Tipos de arquivo -------------------------------------------------------
# A imagem de compartilhamento é gerada sem extensão; sem isso o Facebook e o
# WhatsApp recusam a prévia.
<Files "opengraph-image">
  ForceType image/png
</Files>

AddType image/webp .webp

# --- Compressão -------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- Cache ------------------------------------------------------------------
<IfModule mod_headers.c>
  # Arquivos com hash no nome nunca mudam de conteúdo.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Fotos e logos: 30 dias.
  <FilesMatch "\.(webp|png|jpe?g|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # HTML sempre revalidado, para uma republicação aparecer na hora.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
